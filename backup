#!/usr/bin/env bash
set -euo pipefail

# -----------------------------------------------------------------------
# Backup project directories to external SSD
#
# exFAT-optimized: no perms/owner/group/symlinks (unsupported)
# Parallel: syncs subdirectories concurrently for throughput
#
# Modes:
#   ./backup              — new full backup, prunes old ones
#   ./backup Personal     — new backup of Personal, prunes old ones
#   ./backup Personal/dev — updates latest backup's subfolder in-place
# -----------------------------------------------------------------------

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
source "$script_dir/lib/config.sh"
DEFAULT_KEEP=2
DEFAULT_JOBS=4

# Excludes for rsync
#
# .git/ is deliberately NOT excluded: a backup that drops it restores working
# trees with no history, no stashes and no un-pushed branches.
EXCLUDES=(
	node_modules/
	__pycache__/
	.venv/
	venv/
	.conda/
	"*.pyc"
	target/
	dist/
	build/
	.cache/
	.next/
	.nuxt/
	.ror/
	.playwright-mcp/
	.DS_Store
	Thumbs.db
	wandb/
	.uv-cache/
	.plugin_symlinks/

	# ~/.config only. Anchored with a leading / so they match the top level of
	# a source and are simply inert for the others.
	# Browser profiles and app caches — bulk, and they hold live session cookies:
	/zen
	/orca
	/chromium
	/net.imput.helium
	/heroic
	/Antigravity
	/netlify
	/deepchainlabs-desktop
	# Credential and message stores — an exFAT drive keeps no permissions, so
	# anything here would sit world-readable on a stick in a drawer:
	/1Password
	/Bitwarden
	/Signal
)

# exFAT-optimized rsync flags:
#   -r              recursive
#   --times         preserve modification times
#   --modify-window=1   exFAT timestamp tolerance (2-second granularity)
#   --no-links      skip symlinks (exFAT can't store them)
#   --no-perms      exFAT ignores Unix permissions
#   --no-owner      exFAT ignores ownership
#   --no-group      exFAT ignores group
#   --omit-dir-times  skip directory timestamps (exFAT dir mtime unreliable)
#   --whole-file    skip delta algorithm (local copy, no benefit)
#   --inplace       write directly, no temp files (faster on exFAT)
RSYNC_FLAGS=(
	-r --times --modify-window=1
	--no-links --no-perms --no-owner --no-group
	--omit-dir-times --whole-file --inplace
)

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
BOLD='\033[1m'
NC='\033[0m'

log()  { echo -e "${GREEN}[backup]${NC} $1"; }
warn() { echo -e "${YELLOW}[backup]${NC} $1"; }
err()  { echo -e "${RED}[backup]${NC} $1"; }
info() { echo -e "${BLUE}[backup]${NC} $1"; }

notify() {
	local title="$1" body="${2:-}"
	if command -v notify-send &>/dev/null; then
		notify-send -a "dev-backup" "$title" "$body" 2>/dev/null || true
	fi
}

# -----------------------------------------------------------------------
# Parse arguments
# -----------------------------------------------------------------------
dry_run=0
verify_mode=0
sync_mode=0
keep=$DEFAULT_KEEP
jobs=$DEFAULT_JOBS
targets=()

while [[ $# -gt 0 ]]; do
	case "$1" in
		--dry)    dry_run=1 ;;
		--verify) verify_mode=1 ;;
		--sync)   sync_mode=1 ;;
		--keep)   shift; keep="${1:?--keep requires a number}" ;;
		--jobs)   shift; jobs="${1:?--jobs requires a number}" ;;
		--ssd)    shift; SSD="${1:?--ssd requires a path}"; BACKUP_ROOT="$SSD/backups" ;;
		-h|--help)
			cat <<-EOF
			Usage: backup [targets...] [options]

			Backup project directories to an external SSD using parallel rsync.

			Modes (auto-detected):
			  ./backup                  Full snapshot of all configured sources
			  ./backup Personal         Full snapshot of specific source(s)
			  ./backup Personal/dev     Update subfolder in latest backup (in-place)
			  ./backup --sync           Incremental sync to latest backup
			  ./backup --verify         Compare latest backup against live source

			Options:
			  --dry               Preview mode — show what would be synced
			  --sync              Incremental sync (no new snapshot directory)
			  --verify            Verify latest backup integrity
			  --keep <n>          Keep N snapshots, prune older ones (default: $DEFAULT_KEEP)
			  --jobs <n>          Parallel rsync workers (default: $DEFAULT_JOBS)
			  --ssd <path>        Override SSD mount path
			  -h, --help          Show this help message
			EOF
			exit 0
			;;
		-*)
			err "unknown option: $1  (see --help)"
			exit 1
			;;
		*)        targets+=("$1") ;;
	esac
	shift
done

if ! [[ "$keep" =~ ^[1-9][0-9]*$ ]]; then
	err "--keep must be a positive integer"
	exit 1
fi
if ! [[ "$jobs" =~ ^[1-9][0-9]*$ ]]; then
	err "--jobs must be a positive integer"
	exit 1
fi

# -----------------------------------------------------------------------
# Check dependencies
# -----------------------------------------------------------------------
command -v rsync &>/dev/null || { err "rsync required"; exit 1; }
use_ionice=0
if command -v ionice &>/dev/null; then
	use_ionice=1
fi

# Run rsync at low I/O priority when possible, so a backup doesn't stall the desktop
nice_rsync=(rsync)
[[ $use_ionice -eq 1 ]] && nice_rsync=(ionice -c 2 -n 0 rsync)

# rsync stderr from the parallel workers lands here so failures are reported
# instead of being swallowed by >/dev/null
ERRLOG=$(mktemp -t backup-errors.XXXXXX)
trap 'rm -f "$ERRLOG"' EXIT

# Classify an rsync exit code.
#   0  clean
#   23 partial transfer — individual files could not be written (on exFAT that
#      is usually a filename containing : " * ? < > | ). The snapshot is
#      otherwise complete, so this does not fail the run — but the offending
#      files get named from $ERRLOG instead of vanishing silently.
#   *  real failure — fails the run, which also blocks pruning
reap_rsync() {
	case "$1" in
		0|23) return 0 ;;
		*)    return 1 ;;
	esac
}

# Print whatever rsync complained about, if anything
report_errlog() {
	local lines
	# `|| true`: an empty errlog makes grep exit 1, and pipefail would kill the run
	lines=$(grep -v '^rsync error:' "$ERRLOG" 2>/dev/null | sort -u || true)
	[[ -n "$lines" ]] || return 0
	echo ""
	warn "rsync reported problems — these files are NOT in the backup:"
	head -20 <<< "$lines"
}

# -----------------------------------------------------------------------
# Check SSD
# -----------------------------------------------------------------------
if ! mountpoint -q "$SSD" 2>/dev/null; then
	try_mount_ssd || { err "SSD not mounted at $SSD (and auto-mount failed)"; exit 1; }
fi

fs_info=$(df -Th "$SSD" | awk 'NR==2 {printf "%s | %s/%s used | %s free", $2, $4, $3, $5}')

# -----------------------------------------------------------------------
# Build rsync exclude flags
# -----------------------------------------------------------------------
exclude_flags=()
for pat in "${EXCLUDES[@]}"; do
	exclude_flags+=(--exclude "$pat")
done

# -----------------------------------------------------------------------
# Verify mode: compare latest backup against live source
# -----------------------------------------------------------------------
if [[ $verify_mode -eq 1 ]]; then
	latest=$(latest_snapshot)
	if [[ -z "$latest" ]]; then
		err "no backup found to verify"
		exit 1
	fi

	log "verifying backup: $(basename "$latest")"
	log "SSD: $fs_info"
	echo ""

	verify_failed=0
	for src in "${SOURCES[@]}"; do
		src_path="$HOME/$src"
		backup_path="$latest/$src"

		if [[ ! -d "$src_path" ]]; then
			warn "source missing: $src_path (skipped)"
			continue
		fi
		if [[ ! -d "$backup_path" ]]; then
			err "not in backup: $src"
			verify_failed=1
			continue
		fi

		# Count files (excluding common ignores)
		exclude_args=()
		for pat in "${EXCLUDES[@]}"; do
			exclude_args+=(--exclude "$pat")
		done

		# capture rc separately — a failed rsync used to yield count 0, which
		# read as "OK" and made --verify fail open
		verify_out=$(mktemp -t backup-verify.XXXXXX)
		rsync "${RSYNC_FLAGS[@]}" "${exclude_args[@]}" --dry-run --stats \
			"$src_path/" "$backup_path/" >"$verify_out" 2>/dev/null && verify_rc=0 || verify_rc=$?
		local_count=$(grep "^Number of regular files transferred:" "$verify_out" | awk '{print $NF}')
		rm -f "$verify_out"
		[[ -z "$local_count" ]] && local_count=0

		if [[ $verify_rc -ne 0 && $verify_rc -ne 23 ]]; then
			err "$src: CANNOT VERIFY (rsync exit $verify_rc)"
			verify_failed=1
			continue
		fi

		# derive du's excludes from EXCLUDES so the two can't drift apart
		du_excludes=()
		for pat in "${EXCLUDES[@]}"; do
			p="${pat%/}"; p="${p#/}"
			du_excludes+=(--exclude="$p")
		done
		local_size=$(du -sh "$src_path" "${du_excludes[@]}" 2>/dev/null | cut -f1)
		backup_size=$(du -sh "$backup_path" 2>/dev/null | cut -f1)

		if [[ "$local_count" -le 5 ]]; then
			log "$src: OK  (source: $local_size, backup: $backup_size, $local_count file(s) differ)"
		else
			warn "$src: STALE  (source: $local_size, backup: $backup_size, $local_count file(s) differ)"
			verify_failed=1
		fi
	done

	echo ""
	if [[ $verify_failed -eq 0 ]]; then
		log "backup verified — all sources match"
	else
		warn "backup has drifted — consider running a new backup"
	fi
	exit $verify_failed
fi

# -----------------------------------------------------------------------
# Sync mode: incremental update to latest backup
# -----------------------------------------------------------------------
if [[ $sync_mode -eq 1 ]]; then
	latest=$(latest_snapshot)
	if [[ -z "$latest" ]]; then
		err "no existing backup to sync — run a full backup first"
		exit 1
	fi

	log "SSD: $fs_info"
	log "sync mode: updating $(basename "$latest") in-place"

	if [[ ${#targets[@]} -eq 0 ]]; then
		sources=("${SOURCES[@]}")
	else
		sources=("${targets[@]}")
	fi

	start_time=$SECONDS
	sync_failed=0

	echo ""
	if [[ $dry_run -eq 1 ]]; then
		warn "=== DRY RUN — no changes will be made ==="
		echo ""
	fi

	for src in "${sources[@]}"; do
		src_path="$HOME/$src"
		if [[ ! -d "$src_path" ]]; then
			err "source not found: $src_path"
			sync_failed=1
			continue
		fi

		dest="$latest/$src"

		if [[ $dry_run -eq 1 ]]; then
			info "syncing $src (dry run)..."
			rsync "${RSYNC_FLAGS[@]}" "${exclude_flags[@]}" --dry-run --stats \
				"$src_path/" "$dest/" 2>&1 | grep -E "^(Number|Total)" | head -5
			echo ""
		else
			info "syncing $src..."
			mkdir -p "$dest"
			# capture rc directly — piping into grep would hide it behind pipefail
			rsync_out=$(mktemp -t backup-sync.XXXXXX)
			rsync "${RSYNC_FLAGS[@]}" "${exclude_flags[@]}" --stats \
				"$src_path/" "$dest/" >"$rsync_out" 2>>"$ERRLOG" && rsync_rc=0 || rsync_rc=$?
			grep -E "^(Number|Total)" "$rsync_out" | head -5 || true
			rm -f "$rsync_out"
			reap_rsync "$rsync_rc" || sync_failed=1
			echo ""
		fi
	done

	elapsed=$(( SECONDS - start_time ))

	echo ""
	echo -e "${GREEN}================================${NC}"
	log "sync complete"
	echo -e "${GREEN}================================${NC}"

	if [[ $dry_run -eq 0 ]]; then
		log "time: ${elapsed}s"
		log "target: $(basename "$latest")"

		report_errlog

		if [[ $sync_failed -ne 0 ]]; then
			warn "some items had sync errors — not recording this as a good backup"
		else
			record_backup_time
		fi
	else
		warn "dry run — nothing was changed"
	fi

	echo ""
	free_after=$(df -h "$SSD" | awk 'NR==2 {print $4}')
	log "SSD free space: $free_after"

	if [[ $dry_run -eq 0 ]]; then
		if [[ $sync_failed -eq 0 ]]; then
			notify "Backup sync complete" "Synced in ${elapsed}s | Free: $free_after"
		else
			notify "Backup sync had errors" "Completed in ${elapsed}s with errors"
		fi
	fi

	if [[ $dry_run -eq 0 && $sync_failed -ne 0 ]]; then
		exit 1
	fi
	exit 0
fi

log "SSD: $fs_info"
log "workers: $jobs | retention: $keep"

# -----------------------------------------------------------------------
# Determine mode: full backup vs subfolder update
# -----------------------------------------------------------------------
subfolder_mode=0
if [[ ${#targets[@]} -eq 0 ]]; then
	sources=("${SOURCES[@]}")
else
	sources=()
	for t in "${targets[@]}"; do
		[[ "$t" == */* ]] && subfolder_mode=1
		sources+=("$t")
	done
fi

# Choose backup directory
if [[ $subfolder_mode -eq 1 ]]; then
	# Subfolder mode: update the latest existing backup in-place
	latest=$(latest_snapshot)
	if [[ -z "$latest" ]]; then
		err "no existing backup to update — run a full backup first"
		exit 1
	fi
	backup_dir="$latest"
	log "mode: updating existing backup $(basename "$backup_dir")"
else
	# Full mode: create new timestamped directory
	timestamp=$(date +%Y-%m-%d_%H-%M-%S)
	backup_dir="$BACKUP_ROOT/$timestamp"
	log "mode: new backup $timestamp"
fi

# -----------------------------------------------------------------------
# Sync function: parallel rsync per top-level item in a directory
# -----------------------------------------------------------------------
sync_parallel() {
	local src_path="$1" dest="$2" label="$3"
	local sync_failed_local=0

	info "syncing $label ($jobs parallel workers)..."
	mkdir -p "$dest"

	# Collect all top-level items (dirs + files + dotfiles)
	local items=()
	for item in "$src_path"/* "$src_path"/.*; do
		[[ -e "$item" ]] || continue
		local name
		name=$(basename "$item")
		[[ "$name" == "." || "$name" == ".." ]] && continue
		items+=("$name")
	done

	local total_items=${#items[@]}
	local done_count=0
	local batch_pids=()

	for name in "${items[@]}"; do
		# Skip excluded items
		local excluded=0
		for excl in "${EXCLUDES[@]}"; do
			local excl_name="${excl%/}"
			excl_name="${excl_name#/}"   # anchored patterns skip the same top-level name
			[[ "$name" == "$excl_name" ]] && excluded=1 && break
		done
		if [[ $excluded -eq 1 ]]; then
			done_count=$(( done_count + 1 ))
			continue
		fi

		local item_path="$src_path/$name"

		if [[ -d "$item_path" ]]; then
			mkdir -p "$dest/$name"
			"${nice_rsync[@]}" "${RSYNC_FLAGS[@]}" "${exclude_flags[@]}" \
				"$item_path/" "$dest/$name/" >/dev/null 2>>"$ERRLOG" &
		else
			"${nice_rsync[@]}" "${RSYNC_FLAGS[@]}" \
				"$item_path" "$dest/" >/dev/null 2>>"$ERRLOG" &
		fi
		batch_pids+=($!)

		# Throttle: wait for batch when hitting max jobs
		if (( ${#batch_pids[@]} >= jobs )); then
			for pid in "${batch_pids[@]}"; do
				wait "$pid" 2>/dev/null; local rc=$?
				reap_rsync $rc || sync_failed_local=1
				done_count=$(( done_count + 1 ))
			done
			info "  [$done_count/$total_items] items synced..."
			batch_pids=()
		fi
	done

	# Wait for remaining batch
	for pid in "${batch_pids[@]}"; do
		wait "$pid" 2>/dev/null; local rc=$?
		reap_rsync $rc || sync_failed_local=1
		done_count=$(( done_count + 1 ))
	done

	log "done: $label [$done_count/$total_items items]"
	return $sync_failed_local
}

# -----------------------------------------------------------------------
# Run backup
# -----------------------------------------------------------------------
start_time=$SECONDS
sync_failed=0

echo ""
if [[ $dry_run -eq 1 ]]; then
	warn "=== DRY RUN — no changes will be made ==="
	echo ""
fi

for src in "${sources[@]}"; do
	src_path="$HOME/$src"

	if [[ ! -d "$src_path" ]]; then
		err "source not found: $src_path"
		sync_failed=1
		continue
	fi

	dest="$backup_dir/$src"

	# ---------------------------------------------------------------
	# DRY RUN: single rsync, verbose, serial
	# ---------------------------------------------------------------
	if [[ $dry_run -eq 1 ]]; then
		info "syncing $src (dry run)..."
		rsync "${RSYNC_FLAGS[@]}" "${exclude_flags[@]}" --dry-run --stats \
			"$src_path/" "$dest/" 2>&1 | grep -E "^(Number|Total)" | head -5
		log "done: $src (dry run)"
		echo ""
		continue
	fi

	# ---------------------------------------------------------------
	# REAL BACKUP: parallel rsync
	# ---------------------------------------------------------------
	sync_parallel "$src_path" "$dest" "$src" || sync_failed=1
	echo ""
done

elapsed=$(( SECONDS - start_time ))

# -----------------------------------------------------------------------
# Prune old backups (only for full backups, not subfolder updates)
# -----------------------------------------------------------------------
# Only a clean, complete snapshot earns the right to delete an older one.
# Pruning after a failed or partial run is how you end up with nothing but
# a truncated backup.
prune_skip_reason=""
if [[ $dry_run -eq 1 ]]; then
	prune_skip_reason="dry run"
elif [[ $subfolder_mode -eq 1 ]]; then
	prune_skip_reason="subfolder update, not a new snapshot"
elif [[ ${#targets[@]} -gt 0 ]]; then
	prune_skip_reason="partial snapshot (only: ${targets[*]}) — would prune complete ones"
elif [[ $sync_failed -ne 0 ]]; then
	prune_skip_reason="this backup had errors — keeping every older snapshot"
fi

if [[ -z "$prune_skip_reason" ]]; then
	mapfile -t all_backups < <(list_snapshots)
	total=${#all_backups[@]}

	if (( total > keep )); then
		prune_count=$(( total - keep ))
		log "pruning $prune_count old backup(s) (keeping $keep)..."
		for (( i=0; i<prune_count; i++ )); do
			old="${all_backups[$i]}"
			# never delete the snapshot this run just wrote
			[[ "$old" == "$backup_dir" ]] && continue
			info "  removing: $(basename "$old")"
			rm -rf "$old"
		done
	fi
elif [[ $dry_run -eq 0 ]]; then
	warn "skipping prune: $prune_skip_reason"
fi

# -----------------------------------------------------------------------
# Summary
# -----------------------------------------------------------------------
echo ""
echo -e "${GREEN}================================${NC}"
log "backup complete"
echo -e "${GREEN}================================${NC}"

if [[ $dry_run -eq 0 ]]; then
	backup_size=$(du -sh "$backup_dir" 2>/dev/null | cut -f1)
	log "time: ${elapsed}s"
	log "size: $backup_size"
	log "location: $backup_dir"
	echo ""
	log "remaining backups:"
	mapfile -t remaining < <(find "$BACKUP_ROOT" -mindepth 1 -maxdepth 1 -type d | sort)
	for b in "${remaining[@]}"; do
		size=$(du -sh "$b" 2>/dev/null | cut -f1)
		echo -e "  ${BOLD}$(basename "$b")${NC}  ${size}"
	done

	# Files rsync could not write (exFAT-illegal names, I/O errors) — name them,
	# don't let them disappear silently
	report_errlog

	# Record successful backup time
	if [[ $sync_failed -eq 0 ]]; then
		record_backup_time
	else
		echo ""
		warn "some items had sync errors (non-fatal)"
	fi
else
	warn "dry run — nothing was written"
fi

echo ""
free_after=$(df -h "$SSD" | awk 'NR==2 {print $4}')
log "SSD free space: $free_after"

if [[ $dry_run -eq 0 ]]; then
	if [[ $sync_failed -eq 0 ]]; then
		notify "Backup complete" "${backup_size} in ${elapsed}s | Free: $free_after"
	else
		notify "Backup had errors" "Completed in ${elapsed}s with errors"
	fi
fi

if [[ $dry_run -eq 0 && $sync_failed -ne 0 ]]; then
	exit 1
fi
